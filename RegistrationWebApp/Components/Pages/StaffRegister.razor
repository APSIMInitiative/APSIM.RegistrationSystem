@namespace RegistrationWebApp.Components.Pages
@page "/staff-member-register/{ProductId?}"
@using RegistrationShared.Models
@using RegistrationWebApp.Components.Layout.CustomLayout
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Utilities
@using System.ComponentModel.DataAnnotations
@using RegistrationShared.Enums;
@using RegistrationWebApp.Components.Utilities.Models
@rendermode InteractiveServer
@inject ILogger<StaffRegister> Logger
@inject WebApiUtility WebApiUtility

<PageTitle>Staff & Member Registration</PageTitle>

<Row>
    <Col CustomColClasses="col-12 col-md-8 offset-md-2 text-center">
        <h1 class="text-center">Staff & Member Registration</h1>
        <p class="text-center">Enter an email address and select the organisation/business from the list.</p>
        <EditForm Model="formdata" OnValidSubmit="HandleValidSubmit">
            <InputText id="emailInput" class="form-control" @bind-Value="formdata.EmailInput" />
            <InputText id="nameInput" class="form-control mt-2" @bind-Value="formdata.NameInput" />
            <InputSelect id="organisationSelect" class="form-control" @bind-Value="formdata.SelectedOrganisation">
                @foreach (var organisation in formdata.Organisations)
                {
                    <option value="@organisation">@organisation</option>
                }
            </InputSelect>
            <button type="submit" class="btn btn-primary">Register</button>
        </EditForm>
    </Col>
</Row>

<CustomModal @bind-IsOpen="isModalOpen" Title="@modalTitle">
    @modalMessage
</CustomModal>


@code{
    [Parameter]
    public string? ProductId { get; set; }
    private FormData formdata = new FormData();
    private bool isModalOpen = false;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;

    private List<MemberOrganisation> memberOrganisations = new List<MemberOrganisation>();
    private List<SpecialUseRegistration> specialUseRegistrations = new List<SpecialUseRegistration>();

    /// <summary>
    /// Called when the component is initialized. 
    /// It fetches the list of organisations/businesses from the API and 
    /// populates the dropdown list for user selection during registration.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Fetch the list of organisations/businesses from the API and populate the dropdown list.
        try
        {
            formdata.Organisations = await WebApiUtility.GetMemberOrgAndSpecialUseOrgNames();
            memberOrganisations = await WebApiUtility.GetMemberOrganisationsAsync();
            specialUseRegistrations = (await WebApiUtility.GetRegistrationsAsync()).
                OfType<SpecialUseRegistration>().
                Where(r => r.LicenceStatus == LicenceStatus.SpecialActive).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching organisation names for staff registration.");
            ShowModal("Error", "There was an error fetching organisation names. Please try again later.");  
        }
    }

    /// <summary>
    /// This class represents the form data.
    /// </summary>
    private class FormData
    {
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string EmailInput { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your name.")]
        public string NameInput { get; set; } = string.Empty;

        // This property will hold the selected organisation/business from the list.
        [Required(ErrorMessage = "Please select an organisation.")]
        public string SelectedOrganisation { get; set; } = string.Empty;

        // This list will hold the organisations/businesses that a user can select from when registering.
        public List<string> Organisations { get; set; } = new List<string>();
    }

    /// <summary>This method is called when the form is submitted and the email input is valid. </summary>
    private async Task HandleValidSubmit()
    {
        Logger.LogInformation("Form submitted with email: {Email}", formdata.EmailInput);
        try
        {
            if (memberOrganisations.Any<MemberOrganisation>(o => o.OrganisationName == formdata.SelectedOrganisation))
            {
                MemberOrganisationRegistration registration = new MemberOrganisationRegistration
                {
                    ContactEmail = formdata.EmailInput,
                    ContactName = formdata.NameInput,
                    AgreesToTerms = true,
                    LicenceStatus = LicenceStatus.AwaitingEmailVerification,
                    MemberOrganisationId = memberOrganisations.First(o => o.OrganisationName == formdata.SelectedOrganisation).Id
                };
                HttpResponseMessage response = await WebApiUtility.AddMemberRegistration(registration);
                if (response.IsSuccessStatusCode)
                {
                    ShowModal("Registration Successful", 
                        "You have been successfully registered. Please check your email for further instructions.");
                }
                else
                {
                    ShowModal("Registration Failed", 
                        "There was an error during registration. Please try again later.");
                }
            }
            else if(specialUseRegistrations.Any<SpecialUseRegistration>(r => r.OrganisationName == formdata.SelectedOrganisation))
            {
                SpecialUseStaffRegistration registration = new ()
                {
                    ContactEmail = formdata.EmailInput,
                    ContactName = formdata.NameInput,
                    AgreesToTerms = true,
                    LicenceStatus = LicenceStatus.AwaitingEmailVerification,
                    SpecialUseRegistrationId = specialUseRegistrations.First(r => r.OrganisationName == formdata.SelectedOrganisation).Id
                };
                ResponseModel response = await WebApiUtility.CreateRegistrationAsync(registration);
                if (response.IsSuccess)
                {
                    ShowModal("Registration Successful",
                        "You have been successfully registered. Please check your email for further instructions.");
                }
                else
                {
                    ShowModal("Registration Failed",
                        "There was an error during registration. Please try again later.");
                }
            }
            else
            {
                ShowModal("Registration Error", "Unable to find the selected organisation.");
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during staff/member registration for email: {Email}", formdata.EmailInput);
            ShowModal("Registration Failed", "There was an error during registration. Please try again later.");
        }
    }

    /// <summary>
    /// Displays a modal dialog with the specified title and message.
    /// </summary>
    /// <param name="title"></param>
    /// <param name="message"></param>
    private void ShowModal(string title, string message)
    {
        modalTitle = title;
        modalMessage = message;
        isModalOpen = true;
    }
}
