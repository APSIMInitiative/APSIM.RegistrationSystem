
@namespace RegistrationWebApp.Components.Layout

@inherits LayoutComponentBase

<div class="page">
    @* <div class="sidebar">
        <NavMenu />
    </div> *@
    <main>
        <article class="content px-4">
            <div class="row g-4 align-items-start">
                <div class="col-12 col-md-auto">
                    <a id="apsim-main-logo" href="/" class="d-inline-block">
                        <img class="d-block" src="/APSIM_transparent-154x100.png" alt="APSIM logo" />
                    </a>
                </div>
                <div class="col-12 col-md">
                    @Body
                </div>
            </div>
        </article>
        <Footer />
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
