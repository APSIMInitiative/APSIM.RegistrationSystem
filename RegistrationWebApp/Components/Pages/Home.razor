@using RegistrationWebApp.Components.LayoutObjects
@using RegistrationWebApp.Components.Layout.CustomLayout

@namespace RegistrationWebApp.Components.Pages
@page "/"

<PageTitle>APSIM Registration</PageTitle>

<div class="product-row row g-3">
    <div class="col">
        <h2 class="text-center m-2">Register and Download</h2>
        <div class="product-list row justify-content-center">
            @foreach (var product in Products)
            {
                <div class="col-sm-12 col-md-6 col-lg-4 mb-4 mt-4">
                    <a href="@product.Href" class="text-decoration-none text-dark">
                        <ProductBox Product="product" />
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@* This is the code section for defining the list of products *@
@code{


    private static MarkupString NextGenDescription = new MarkupString(
        "<p>APSIM Next Generation is a complete rewrite of the original APSIM software, first started in 2014, designed to be more modular, extensible, and easier to maintain.</p>" +
        " <p>It is built on modern software development principles and technologies, making it more efficient and user-friendly.</p>" +" <p>If you are new to APSIM or looking for the latest features and improvements, we recommend registering for and downloading APSIM Next Generation.</p>");
    
    private static MarkupString ClassicDescription = new MarkupString(
        "<p>APSIM Classic (7.10) is the original APSIM software first developed in 1990 and later deprecated in 2025.</p>" +
        "<p><em>Please note that from APSIM Classic version 7.10 onwards, the software is no longer being actively developed, and users are encouraged to transition to APSIM Next Generation for the latest features and improvements.</em></p>");

    List<Product> Products = new List<Product>
    {
        new Product
        {
            Name = "APSIM Next Generation",
            Description = NextGenDescription,
            ImageUrl = "/Images/apsim-300.png",
            Href = "register/nextgen",
            FirstButtonText = "New user",
            SecondHref = "existing-user/nextgen",
            SecondButtonText = "Existing user"
        },
        new Product
        {
            Name = "APSIM Classic (7.10)",
            Description = ClassicDescription,
            ImageUrl = "/Images/apsim-classic-300.png",
            Href = "register/classic",
            FirstButtonText = "New user",
            SecondHref = "existing-user/classic",
            SecondButtonText = "Existing user"
        },
    };
}