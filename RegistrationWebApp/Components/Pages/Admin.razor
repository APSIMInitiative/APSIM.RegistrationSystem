@using RegistrationShared.Models
@using RegistrationShared.Enums
@using RegistrationWebApp.Components.Classes.Utilities
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Layout.CustomLayout
@using RegistrationWebApp.Components.Utilities
@using RegistrationWebApp.Components.Utilities.Models
@using Microsoft.JSInterop
@using BlazoredGoogleCaptcha.Responses
@using BlazoredGoogleCaptcha.Services
@using BlazoredGoogleCaptcha

@namespace RegistrationWebApp.Components.Pages
@page "/admin/"
@rendermode InteractiveServer
@inject WebApiUtility WebApiUtility
@inject ILogger<Admin> Logger
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject CaptchaService captchaService


@* Recaptcha code sourced from: https://github.com/CMS365-PTY-LTD/BlazoredGoogleCaptcha *@


<PageTitle>Registration Admin</PageTitle>

<div hidden="@isAuthenticated">
    <div class="login-container container mt-4">
        <div class="row justify-content-center">
            <div class="login-form-div col-12 col-md-6 col-lg-4 border rounded p-4 text-start">
                <form @onsubmit="AuthenticateAdminAsync" @onsubmit:preventDefault>
                    <p class="mb-3">Enter the admin password to continue.</p>
                    <label for="adminPassword" class="form-label">Password</label>
                    <input id="adminPassword" type="password" class="form-control" @bind="adminPasswordInput" />
                    @if (!string.IsNullOrWhiteSpace(passwordErrorMessage))
                    {
                        <div class="text-danger mt-2">@passwordErrorMessage</div>
                    }
                    <button type="submit" class="btn btn-success rounded-pill pill-button mt-3" disabled="@IsButtonDisabled">Unlock Admin</button>
                    @if (IsRecaptchaConfigured)
                    {
                        <div class="mt-2">
                            <Captcha    
                                SiteKey="@Configuration["Recaptcha:v2SiteKey"]" 
                                OnSuccess="@OnCaptchaSuccess" 
                                OnExpired="@OnCaptchaExpired">
                            </Captcha>
                        </div>
                    }
                    else
                    {
                        <div class="text-danger mt-2">Recaptcha is not configured.</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row m-3" hidden="@(!isAuthenticated)">
    <div class="col-12 col-md-10 m-3">
        <div class="summary-row row mt-4 text-center">
            <div class="col-12">
                <div class="row">
                    <div class="col-12">
                        <h2>Summary</h2>
                        <p>Quick metrics for registrations in @CurrentYear</p>
                    </div>
                    <div class="col-12 col-lg-6 mt-3">
                        <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                            <div class="summary-metric-value">@TotalUsers</div>
                            <div class="summary-metric-label">Total Users</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 mt-3">
                        <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                            <div class="summary-metric-value">@TotalSpecialUseOrganisations</div>
                            <div class="summary-metric-label">Total Special Use Organisations</div>
                        </div>
                    </div>
                </div>
                <div id="downloads-graph-row" class="row mt-4">
                    <div class="col-12">
                        <h3>Downloads Over Time</h3>
                        @if (isDownloadMetricsLoading)
                        {
                            <p class="text-muted mb-0">Loading download analytics...</p>
                        }
                        else
                        {
                            <div class="row mt-3">
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalClassicDownloads</div>
                                        <div class="summary-metric-label">Total Classic Downloads</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalNextGenDownloads</div>
                                        <div class="summary-metric-label">Total Next Gen Downloads</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalDownloadsCombined</div>
                                        <div class="summary-metric-label">Total Downloads Combined</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalClassicDownloadsThisYear</div>
                                        <div class="summary-metric-label">Classic Downloads This Year</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalNextGenDownloadsThisYear</div>
                                        <div class="summary-metric-label">Next Gen Downloads This Year</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-4 mt-3">
                                    <div class="summary-metric-card h-100 d-flex flex-column justify-content-center">
                                        <div class="summary-metric-value">@TotalDownloadsCurrentMonth</div>
                                        <div class="summary-metric-label">Total Downloads This Month</div>
                                    </div>
                                </div>
                            </div>

                            <div class="member-org-panel text-start mt-4">
                                <h4>Download CSV Export</h4>
                                <p class="mb-2">Apply filters and export matching download events.</p>
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-md-3">
                                        <label for="downloadCsvFromDate" class="form-label">From Date (UTC)</label>
                                        <InputDate id="downloadCsvFromDate" class="form-control" @bind-Value="csvFilterFromDate" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="downloadCsvToDate" class="form-label">To Date (UTC)</label>
                                        <InputDate id="downloadCsvToDate" class="form-control" @bind-Value="csvFilterToDate" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="downloadCsvEmail" class="form-label">User Email</label>
                                        <input id="downloadCsvEmail" type="email" class="form-control" @bind="csvFilterEmail" placeholder="user@example.com" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="downloadCsvType" class="form-label">Download Type</label>
                                        <select id="downloadCsvType" class="form-select" @bind="csvFilterDownloadType">
                                            <option value="">All</option>
                                            <option value="classic">Classic</option>
                                            <option value="nextgen">Next Gen</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mt-3 d-flex gap-2">
                                    <button type="button" class="btn btn-success rounded-pill pill-button" @onclick="HandleDownloadCsvExportAsync" disabled="@isCsvExportInProgress">
                                        @(isCsvExportInProgress ? "Exporting..." : "Download CSV")
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary rounded-pill" @onclick="ResetDownloadCsvFilters" disabled="@isCsvExportInProgress">
                                        Reset Filters
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row licence-row mt-4 text-center">
            <div class="col licence-col col-12 col-md-12">
                <h2 class="text-center">Licenses</h2>
                <p class="text-center">Here you can manage licences through their lifecycle</p>
                <div class="row row-lg-12 p-3">
                    <div class="row">
                        <div class="col-4 d-flex align-items-start">
                            <button class="btn btn-success rounded-pill pill-button mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="false" aria-controls="collapseUsers">
                                Show/Hide Users
                            </button>
                        </div>
                    </div>
                    <div class="collapse user-regos-col col-lg-12 col-md-12 col-sm-12 m-3" id="collapseUsers">
                        <h3>User Registrations</h3>
                        <table class="table table-sm table-striped table-bordered table-hover table-responsive">
                            <thead class="table-success">
                                <tr>
                                    <th>Email</th>
                                    <th>Licence Status</th>
                                    <th>Date Created</th>
                                    <th>Country</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (User registration in users.
                                    OrderByDescending(r => r.DateCreated))
                                {
                                    <tr>
                                        <td>@registration.Email</td>
                                        <td>@registration.LicenceStatus.GetDescription()</td>
                                        <td>@registration.DateCreated.ToShortDateString()</td>
                                        <td>@registration.Country</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger"
                                                    @onclick="() => HandleDeleteUser(registration)">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row">
                        <div class="col-4 d-flex align-items-start">
                            <button class="btn btn-success rounded-pill pill-button mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOrganisations" aria-expanded="false" aria-controls="collapseOrganisations">
                                Show/Hide Organisations
                            </button>
                        </div>
                    </div>

                    <div class="collapse org-reg-col col-lg-12 col-md-12 col-sm-12 m-3 overflow-auto" id="collapseOrganisations">
                        <h3>Organisations</h3>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered table-hover">
                                <thead class="table-success">
                                    <tr>
                                        <th>Organisation Name</th>
                                        <th>Emails</th>
                                        <th>Licence Pathway</th>
                                        <th>Application Date</th>
                                        <th>Registered Members</th>
                                        <th>Licence Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Organisation organisation in organisations.OrderByDescending(o => o.DateCreated))
                                    {
                                        <tr>
                                            <td>@organisation.Name</td>
                                            <td>@string.Join(",", organisation.Emails )</td>
                                            <td>@organisation.LicencePathway.GetDescription()</td>
                                            <td>@organisation.DateCreated.ToShortDateString()</td>
                                            <td>@CountRegisteredUsersForOrganisation(organisation)</td>
                                            <td>@organisation.LicenceStatus.GetDescription()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="member-org-row row mt-4 text-center">
            <div class="col-12 col-lg-12 col-md-6">
                <h2>Member Organisations</h2>
                <p>Here you can manage member organisations and their associated members</p>
                <div class="add-member-org-row row gx-4 gy-4">
                    <div class="add-member-col col-12 col-lg-6">
                        <div class="member-org-panel h-100">
                            <h3>Add New Member Organisation</h3>
                            <EditForm Model="MemberOrganisation" OnValidSubmit="HandleNewMemberOrganisationSubmit">
                                <InputText id="contactName" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactName" 
                                    placeholder="Name of contact person"></InputText>
                                <InputText id="contactEmail" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactEmail" 
                                    placeholder="Contact Persons Email Address"></InputText>
                                <InputText id="contactAddress" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactAddress" 
                                    placeholder="Member Organisation Address"></InputText>
                                <InputText id="organisationName" class="form-control mt-2" @bind-Value="MemberOrganisation.Name" 
                                    placeholder="Enter organisation name e.g. CSIRO" />
                                <InputSelect id="licencePathway" class="form-select mt-2" @bind-Value="MemberOrganisation.LicencePathway">
                                    @foreach (var licencePathway in Enum.GetValues<LicencePathway>())
                                    {
                                        <option value="@licencePathway">@licencePathway.GetDescription()</option>
                                    }
                                </InputSelect>
                                <InputSelect id="annualTurnover" class="form-select mt-2" @bind-Value="MemberOrganisation.AnnualTurnover">
                                    @foreach (var annualTurnover in Enum.GetValues<AnnualTurnover>())
                                    {
                                        @if (annualTurnover.Equals(AnnualTurnover.NotApplicable))
                                        {
                                            <option value="@annualTurnover" selected>@annualTurnover.GetDescription()</option>
                                        }
                                        <option value="@annualTurnover">@annualTurnover.GetDescription()</option>
                                    }
                                </InputSelect>
                                <InputSelect id="licenceStatus" class="form-select mt-2" @bind-Value="MemberOrganisation.LicenceStatus">
                                    <option value="@OrganisationLicenceStatus.Active" selected>@OrganisationLicenceStatus.Active.GetDescription()</option>
                                    @foreach (var licenceStatus in Enum.GetValues<OrganisationLicenceStatus>())
                                    {
                                        <option value="@licenceStatus">@licenceStatus.GetDescription()</option>
                                    }
                                </InputSelect>
                                <button type="submit" class="btn btn-success rounded-pill pill-button mt-4">Add Member Organisation</button>
                            </EditForm>
                        </div>
                    </div>
                    <div class="existing-member-col col-12 col-lg-6">
                        <div class="member-org-panel h-100">
                            <h3>Existing Member Organisations</h3>
                            <table class="table table-sm table-striped table-bordered table-hover">
                                <thead class="table-success">
                                    <tr>
                                        <th>Organisation Name</th>
                                        <th>Date Created</th>
                                        <th>No. Registered Members</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var memberOrg in organisations 
                                        .Where(o => o.LicencePathway == 
                                        LicencePathway.APSIMInitiativeMember))
                                    {
                                        <tr>
                                            <td>@memberOrg.Name</td>
                                            <td>@memberOrg.DateCreated.ToShortDateString()</td>
                                            <td>@CountRegisteredUsersForOrganisation(memberOrg)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="manage-special-org-row row mt-4 mb-4 text-center">
            <div class="col-12">
                <h2>Manage Organisations</h2>
                <p>Choose an organisation, edit its values, and submit updates to the API.</p>
            </div>
            <div class="col-12">
                <div class="member-org-panel text-start">
                    <label for="specialOrganisationSelector" class="form-label fw-semibold">Organisation Name</label>
                    <select id="specialOrganisationSelector" class="form-select" value="@selectedOrganisationId" @onchange="OnOrganisationSelectionChanged">
                        <option value="">-- Select a special use organisation --</option>
                        @foreach (var organisation in AllOrganisations)
                        {
                            <option value="@organisation.Id">@organisation.Name</option>
                        }
                    </select>

                    @if (GenericOrganisation is not null)
                    {
                        <EditForm Model="GenericOrganisation" OnValidSubmit="HandleSpecialOrganisationSubmit" class="mt-4">
                            <label for="specialOrganisationName" class="form-label">Organisation Name</label>
                            <InputText id="specialOrganisationName" class="form-control" @bind-Value="GenericOrganisation.Name" placeholder="Organisation name" />

                            <label for="specialOrganisationEmails" class="form-label mt-3">Organisation Emails/Domains</label>
                            <InputTextArea id="specialOrganisationEmails" class="form-control" rows="3" @bind-Value="organisationEmailsText" />
                            <div class="form-text">Use comma, semicolon, or newline separators (example: *@@domain.org).</div>

                            <label for="specialLicencePathway" class="form-label mt-2">Licence Pathway</label>
                            <InputSelect id="specialLicencePathway" class="form-select" @bind-Value="GenericOrganisation.LicencePathway">
                                @foreach (var licencePathway in Enum.GetValues<LicencePathway>())
                                {
                                    <option value="@licencePathway">@licencePathway.GetDescription()</option>
                                }
                            </InputSelect>

                            <label for="specialLicenceStatus" class="form-label mt-2">Licence Status</label>
                            <InputSelect id="specialLicenceStatus" class="form-select" @bind-Value="GenericOrganisation.LicenceStatus">
                                @foreach (var licenceStatus in Enum.GetValues<OrganisationLicenceStatus>())
                                {
                                    <option value="@licenceStatus">@licenceStatus.GetDescription()</option>
                                }
                            </InputSelect>

                            <div>
                                <button type="submit" class="btn btn-success rounded-pill pill-button mt-3">Update Organisation</button>
                            </div>

                        </EditForm>
                    }
                    else
                    {
                        <p class="mt-3 mb-0 text-muted">Select an organisation to load editable details.</p>
                    }
                </div>
            </div>
        </div>
    </div>


    <CustomModal @bind-IsOpen="isModalOpen" Title="@modalTitle">
        @modalMessage
    </CustomModal>
</div>

@code{

    private bool isModalOpen = false;
    private bool isAuthenticated = false;
    private string adminPasswordInput = string.Empty;
    private string configuredAdminPassword = string.Empty;
    private string passwordErrorMessage = string.Empty;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;
    private bool isDownloadMetricsLoading;
    private bool isCsvExportInProgress;

    private int TotalClassicDownloads { get; set; }
    private int TotalNextGenDownloads { get; set; }
    private int TotalClassicDownloadsThisYear { get; set; }
    private int TotalNextGenDownloadsThisYear { get; set; }
    private int TotalDownloadsCombined { get; set; }
    private int TotalDownloadsCurrentMonth { get; set; }

    private DateTime? csvFilterFromDate;
    private DateTime? csvFilterToDate;
    private string csvFilterEmail = string.Empty;
    private string csvFilterDownloadType = string.Empty;

    private bool captchaVerified = false;
    private bool IsRecaptchaConfigured =>
        !string.IsNullOrWhiteSpace(Configuration["Recaptcha:v2SiteKey"]) &&
        !string.IsNullOrWhiteSpace(Configuration["Recaptcha:v2SecretKey"]);
    private bool IsButtonDisabled => IsRecaptchaConfigured && !captchaVerified;

    /// <summary>
    /// This property represents a member organisation that can be added through the admin interface.
    /// </summary>
    /// <remarks>
    /// The default values for the LicencePathway, AnnualTurnover, and LicenceStatus properties
    /// are set to APSIMInitiativeMember, BelowTwoMillion, and Active respectively to ensure values are preselected
    /// properly.
    /// </remarks>
    private Organisation MemberOrganisation { get; set; } = new Organisation{
        LicencePathway = LicencePathway.APSIMInitiativeMember,
        AnnualTurnover = AnnualTurnover.BelowTwoMillion,
        LicenceStatus = OrganisationLicenceStatus.Active
    };

    private Organisation? SpecialOrganisation { get; set; }
    private Organisation? GenericOrganisation { get; set; }
    private string selectedOrganisationId = string.Empty;
    private string organisationEmailsText = string.Empty;

    private List<User> users = new List<User>();
    private List<Organisation> organisations = new List<Organisation>();

    private static readonly string[] MonthLabels =
    [
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];

    private int CurrentYear => DateTime.UtcNow.Year;

    private int TotalUsers => users.Count;

    private int TotalSpecialUseOrganisations => SpecialUseOrganisations.Count;

    private int[] UserRegistrationsByMonthCurrentYear =>
        Enumerable.Range(1, 12)
            .Select(month => users.Count(u => u.DateCreated.Year == CurrentYear && u.DateCreated.Month == month))
            .ToArray();


    private List<Organisation> SpecialUseOrganisations => organisations
        .Where(o => o.LicencePathway == LicencePathway.TypeOne || o.LicencePathway == LicencePathway.TypeTwo)
        .OrderBy(o => o.Name)
        .ToList();

    private List<Organisation> AllOrganisations => organisations
        .OrderBy(o => o.Name)
        .ToList();

    private async Task AuthenticateAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(configuredAdminPassword))
        {
            passwordErrorMessage = "Admin password is not configured. Please contact an administrator.";
            return;
        }

        if (!string.Equals(adminPasswordInput, configuredAdminPassword, StringComparison.Ordinal))
        {
            passwordErrorMessage = "Incorrect password.";
            return;
        }

        isAuthenticated = true;
        passwordErrorMessage = string.Empty;
        adminPasswordInput = string.Empty;
        await LoadAdminDataAsync();
    }

    /// <summary>
    /// Handle the submission of a new member organisation. 
    /// This method is called when the form for adding a new member organisation is submitted.
    /// </summary>
    /// <returns></returns>
    private async Task HandleNewMemberOrganisationSubmit()
    {
        Logger.LogInformation($"New Member Organisation Submitted: {MemberOrganisation.Name}");
        if (MemberOrganisation.LicencePathway != LicencePathway.APSIMInitiativeMember)
        {
            Logger.LogWarning(
                $"Attempted to add member organisation with invalid licence pathway: {MemberOrganisation.LicencePathway}"
            );
            ShowModal("Error", 
            "Invalid licence pathway.Member organisations must have the 'APSIM Initiative Member' licence pathway.");
            return;
        }
        HttpResponseMessage response = await WebApiUtility.AddOrganisationAsync(MemberOrganisation);
        if (response.IsSuccessStatusCode)
        {
            Logger.LogInformation("Member organisation added successfully.");
            MemberOrganisation = new Organisation
            {
                LicencePathway = LicencePathway.APSIMInitiativeMember,
                AnnualTurnover = AnnualTurnover.BelowTwoMillion,
                LicenceStatus = OrganisationLicenceStatus.Active
            };
            ShowModal("Success", "Member organisation added successfully.");
            await RefreshUsersAndOrganisationsAsync();
        }
        else
        {
            Logger.LogError($"Failed to add member organisation. Status Code: {response.StatusCode}");
            ShowModal("Error", $"Failed to add member organisation {MemberOrganisation.Name}. Status Code: {response.StatusCode}");
        }
    }

    // This method is called when the component is initialized. 
    // It retrieves data required for the admin page, such as the list of 
    // registrations and member organisations, and handles any errors 
    // that may occur during data retrieval.
    protected override Task OnInitializedAsync()
    {
        configuredAdminPassword = Configuration["Admin:Password"] ?? string.Empty;
        if (string.IsNullOrWhiteSpace(configuredAdminPassword))
            Logger.LogWarning("Admin password is not configured. The admin page cannot be unlocked.");

        return Task.CompletedTask;
    }

    private async Task LoadAdminDataAsync()
    {
        try
        {
            Logger.LogInformation("Admin page authenticated. Fetching registrations and member organisations.");
            await RefreshUsersAndOrganisationsAsync();
            await LoadDownloadMetricsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred while fetching data for the admin page.");
            ShowModal("Error", "An error occurred while fetching data. Please try again later.");
        }
    }

    private async Task RefreshUsersAndOrganisationsAsync()
    {
        users = await WebApiUtility.GetUsersAsync();
        organisations = await WebApiUtility.GetOrganisationsAsync();

        if (!string.IsNullOrWhiteSpace(selectedOrganisationId))
        {
            var selected = organisations.FirstOrDefault(o => o.Id.ToString() == selectedOrganisationId);
            SpecialOrganisation = selected is null ? null : CloneOrganisation(selected);
            if (selected is null)
            {
                selectedOrganisationId = string.Empty;
                organisationEmailsText = string.Empty;
            }
            else
            {
                organisationEmailsText = string.Join(Environment.NewLine, SpecialOrganisation!.Emails);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDownloadMetricsAsync()
    {
        isDownloadMetricsLoading = true;
        try
        {
            var now = DateTime.UtcNow;
            var startOfYearUtc = new DateTime(now.Year, 1, 1, 0, 0, 0, DateTimeKind.Utc);
            var startOfMonthUtc = new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc);

            var classicTotalTask = WebApiUtility.GetDownloadEventsCountAsync(downloadType: "classic");
            var nextGenTotalTask = WebApiUtility.GetDownloadEventsCountAsync(downloadType: "nextgen");
            var classicYearTask = WebApiUtility.GetDownloadEventsCountAsync(fromUtc: startOfYearUtc, toUtc: now, downloadType: "classic");
            var nextGenYearTask = WebApiUtility.GetDownloadEventsCountAsync(fromUtc: startOfYearUtc, toUtc: now, downloadType: "nextgen");
            var combinedTotalTask = WebApiUtility.GetDownloadEventsCountAsync();
            var currentMonthTask = WebApiUtility.GetDownloadEventsCountAsync(fromUtc: startOfMonthUtc, toUtc: now);

            await Task.WhenAll(classicTotalTask, nextGenTotalTask, classicYearTask, nextGenYearTask, combinedTotalTask, currentMonthTask);

            TotalClassicDownloads = classicTotalTask.Result;
            TotalNextGenDownloads = nextGenTotalTask.Result;
            TotalClassicDownloadsThisYear = classicYearTask.Result;
            TotalNextGenDownloadsThisYear = nextGenYearTask.Result;
            TotalDownloadsCombined = combinedTotalTask.Result;
            TotalDownloadsCurrentMonth = currentMonthTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load download analytics metrics.");
            ShowModal("Error", "Failed to load download analytics metrics.");
        }
        finally
        {
            isDownloadMetricsLoading = false;
        }
    }

    private async Task HandleDownloadCsvExportAsync()
    {
        var fromUtc = ParseStartDateUtc(csvFilterFromDate);
        var toUtc = ParseEndDateUtc(csvFilterToDate);

        if (fromUtc.HasValue && toUtc.HasValue && fromUtc.Value > toUtc.Value)
        {
            ShowModal("Error", "From Date must be earlier than or equal to To Date.");
            return;
        }

        isCsvExportInProgress = true;
        try
        {
            var result = await WebApiUtility.ExportDownloadEventsCsvAsync(
                fromUtc,
                toUtc,
                string.IsNullOrWhiteSpace(csvFilterEmail) ? null : csvFilterEmail.Trim(),
                string.IsNullOrWhiteSpace(csvFilterDownloadType) ? null : csvFilterDownloadType);

            if (result is null || result.Bytes.Length == 0)
            {
                ShowModal("Error", "CSV export failed or returned no content.");
                return;
            }

            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                result.FileName,
                result.ContentType,
                Convert.ToBase64String(result.Bytes));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "CSV export failed.");
            ShowModal("Error", "CSV export failed. Please try again.");
        }
        finally
        {
            isCsvExportInProgress = false;
        }
    }

    private static DateTime? ParseStartDateUtc(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        var dateOnly = date.Value.Date;
        return DateTime.SpecifyKind(dateOnly, DateTimeKind.Utc);
    }

    private static DateTime? ParseEndDateUtc(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        var dateOnly = date.Value.Date.AddDays(1).AddTicks(-1);
        return DateTime.SpecifyKind(dateOnly, DateTimeKind.Utc);
    }

    private void ResetDownloadCsvFilters()
    {
        csvFilterFromDate = null;
        csvFilterToDate = null;
        csvFilterEmail = string.Empty;
        csvFilterDownloadType = string.Empty;
    }

    /// <summary>
    /// Displays a modal dialog with the specified title and message. This method sets the modal's title and message,
    /// and opens the modal.
    /// </summary>
    /// <param name="title">The title of the modal dialog.</param>
    /// <param name="message">The message to be displayed in the modal dialog.</param>
    private void ShowModal(string title, string message)
    {
        modalTitle = title;
        modalMessage = message;
        isModalOpen = true;
    }

    private void OnOrganisationSelectionChanged(ChangeEventArgs e)
    {
        selectedOrganisationId = e.Value?.ToString() ?? string.Empty;
        var selected = AllOrganisations.FirstOrDefault(o => o.Id.ToString() == selectedOrganisationId);
        GenericOrganisation = selected is null ? null : CloneOrganisation(selected);
        organisationEmailsText = GenericOrganisation is null
            ? string.Empty
            : string.Join(Environment.NewLine, GenericOrganisation.Emails);
    }

    private static List<string> ParseOrganisationEmails(string emailsText)
    {
        return emailsText
            .Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(value => value.Trim())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private int CountRegisteredUsersForOrganisation(Organisation organisation)
    {
        return users.Count(user => organisation.IsFromOrganisation(user.Email));
    }

    private static Organisation CloneOrganisation(Organisation organisation)
    {
        return new Organisation
        {
            Id = organisation.Id,
            Name = organisation.Name,
            Emails = organisation.Emails.ToList(),
            LicenceStatus = organisation.LicenceStatus,
            ContactName = organisation.ContactName,
            ContactEmail = organisation.ContactEmail,
            ContactPhone = organisation.ContactPhone,
            ContactAddress = organisation.ContactAddress,
            LicencePathway = organisation.LicencePathway,
            AnnualTurnover = organisation.AnnualTurnover,
            DateCreated = organisation.DateCreated
        };
    }

    private async Task HandleSpecialOrganisationSubmit()
    {
        if (GenericOrganisation is null)
        {
            ShowModal("Error", "Please select a special use organisation to update.");
            return;
        }

        GenericOrganisation.Emails = ParseOrganisationEmails(organisationEmailsText);
        if (GenericOrganisation.Emails.Count == 0)
        {
            ShowModal("Error", "At least one organisation email/domain is required.");
            return;
        }

        HttpResponseMessage response = await WebApiUtility.UpdateOrganisationAsync(GenericOrganisation);
        if (response.IsSuccessStatusCode)
        {
            ShowModal("Success", $"Organisation '{GenericOrganisation.Name}' updated successfully.");
            await RefreshUsersAndOrganisationsAsync();
            return;
        }

        Logger.LogError("Failed to update organisation {OrganisationId}. Status code: {StatusCode}", GenericOrganisation.Id, response.StatusCode);
        ShowModal("Error", $"Failed to update organisation '{GenericOrganisation.Name}'. Status Code: {response.StatusCode}");
    }

    private async Task HandleDeleteUser(User user)
    {
        HttpResponseMessage response = await WebApiUtility.DeleteUserAsync(user.Id);
        if (response.IsSuccessStatusCode)
        {
            ShowModal("Success", $"User '{user.Email}' deleted successfully.");
            await RefreshUsersAndOrganisationsAsync();
            return;
        }

        Logger.LogError("Failed to delete user {UserId}. Status code: {StatusCode}", user.Id, response.StatusCode);
        ShowModal("Error", $"Failed to delete user '{user.Email}'. Status Code: {response.StatusCode}");
    }

    private async void OnCaptchaSuccess(string response)
    {
        string? captchaSecret = Configuration["Recaptcha:v2SecretKey"];
        if (string.IsNullOrWhiteSpace(captchaSecret))
        {
            Logger.LogError("Recaptcha secret key is not configured.");
            captchaVerified = false;
            StateHasChanged();
            return;
        }

        CaptchaV2Response? captchaResponse = await captchaService.VerifyV2(captchaSecret, response);
        if (captchaResponse.Success)
        {
            captchaVerified = true;
            StateHasChanged();
        }
        else
        {
            //show error message or handle failure
        }
    }

    private void OnCaptchaExpired()
    {
        captchaVerified = false;
    }

