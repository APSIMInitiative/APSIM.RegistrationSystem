@using RegistrationWebApp.Components.LayoutObjects
@using RegistrationWebApp.Components.Layout.CustomLayout

@namespace RegistrationWebApp.Components.Pages
@page "/"

<PageTitle>APSIM Registration</PageTitle>

<h2 class="text-center m-2">Register and Download</h2>
<div class="col">
    <div class="row justify-content-center">
        <div id="description-section" class="col-sm-12 col-md-12 col-lg-8 mb-4 mt-4">
            <div class="row g-4">
                <div class="col col-sm-12 col-md-12 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm intro-card">
                        <div class="card-body d-flex flex-column align-items-center text-center p-4">
                            <span class="intro-card-icon intro-card-icon-rewrite mb-3" aria-hidden="true"></span>
                            <p class="card-text mb-0">
                                The Agricultural Production Systems sIMulator (APSIM) is internationally recognised as 
                                a highly advanced platform for modelling and simulation of agricultural systems. 
                                It contains a suite of modules that enable the simulation of systems for a diverse 
                                range of plant, animal, soil, climate and management interactions.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col col-sm-12 col-md-12 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm intro-card">
                        <div class="card-body d-flex flex-column align-items-center text-center p-4">
                            <span class="intro-card-icon intro-card-icon-technology mb-3" aria-hidden="true"></span>
                            <p class="card-text mb-0">
                                Compatible on all major operating systems including Windows,
                                MacOS and Debian-based Linux distributions.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col col-sm-12 col-md-12 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm intro-card">
                        <div class="card-body d-flex flex-column align-items-center text-center p-4">
                            <span class="intro-card-icon intro-card-icon-download mb-3" aria-hidden="true"></span>
                            <p class="card-text mb-0">
                                Please use the options below to select the appropriate 
                                licence type to register and download APSIM.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="product-row row">
        <div class="col">
            <div class="product-list row justify-content-center">
                @foreach (var product in Products)
                {
                    <div class="col-sm-12 col-md-6 col-lg-4 mb-4 mt-4">
                        <a href="@product.Href" class="text-decoration-none text-dark">
                            <ProductBox Product="product" />
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="classic-row" class="row justify-content-center mb-4 mt-4">
        <div class="col text-center">
            <p> Looking for APSIM Classic? </p>
            <a class="d-inline-block" href="/validate">Legacy download available here</a>
        </div>
    </div>

</div>

@code{


    private static MarkupString NextGenDescription = new MarkupString(
        "<li>For educational purposes, for personal learning, or for public good research</li>" +
        "<li>Free of charge</li>" +
        "<li>Required to submit modifications back to the APSIM Initiative for potential inclusion in the main codebase</li>"
    );
    
    private static MarkupString SpecialUseDescription = new MarkupString(
        "<li>For consulting, commercial research, or any activity that generates revenue.</li>" +
        "<li>Requires a fee</li>" +
        "<li>Licencee can keep modifications for private use (Type 2) or " +
        "submit back to the APSIM Initiative for potential inclusion in the main codebase (Type 1)</li>"
    );

    List<Product> Products = new List<Product>
    {
        new Product
        {
            Name = "APSIM",
            Description = NextGenDescription,
            ImageUrl = "/Images/apsim-300.png",
            Href="validate",
            FirstButtonText = "Download",
            SecondHref = "https://www.apsim.info/registration/general-use-licence/",
            SecondButtonText = "General Use Licence",
        },
        new Product
        {
            Name = "APSIM Special Use Licencing Enquiry",
            Description = SpecialUseDescription,
            ImageUrl = "/Images/apsim-special-use-300.png",
            Href = "register",
            FirstButtonText = "Register or enquire",
            SecondHref = "https://www.apsim.info/download-apsim/",
            SecondButtonText = "Special Use Licence", 
        },
    };
}