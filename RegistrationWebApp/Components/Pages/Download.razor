@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using RegistrationWebApp.Components.Classes
@using RegistrationWebApp.Components.Layout.CustomLayout
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Utilities
@using RegistrationWebApp.Components.Utilities.Models

@namespace RegistrationWebApp.Components.Pages
@page "/download"
@rendermode InteractiveServer
@inject ILogger<Download> Logger
@inject NavigationManager NavigationManager
@inject WebApiUtility WebApiUtility
@inject DownloadAccessState DownloadAccessState
@inject APSIMBuildsAPIUtility APSIMBuildsAPIUtility
@inject IJSRuntime JS

<PageTitle>Download</PageTitle>

<div class="row">
    <div class="download-page-card col-6 offset-3">
        <h1 class="text-center m-3">Downloads</h1>
        <p class="download-lead text-center m-3">
            Access to this page is provided via your secure download link.
        </p>

        @if (isTokenValidationInProgress)
        {
            <p class="text-center">Validating your download link...</p>
            <div id="download-spinner" class="text-center">
                <div class="spinner-border text-success text-center" style="width: 8rem; height: 8rem;" role="status"></div>
            </div>
        }
        else if (!hasValidToken)
        {
            <div class="alert alert-warning text-center" role="alert">
                <p>Your download link is invalid or has expired. Please request a new link.</p>
            </div>
            <div class="text-center">
                <a href="/" class="btn btn-success pill-button">Go back to the homepage</a>
            </div>
        }
        else
        {
            <div class="download-results">
                <h2>APSIM Product Downloads</h2>
                <select class="form-select download-select" aria-label="Select download type" value="@selectedDownloadType" @onchange="OnDownloadTypeChanged">
                    <option value="nextgen">APSIM Next Generation Downloads</option>
                    <option value="classic">APSIM Classic (7.10) Downloads</option>
                </select>

            @if (isSelectionLoading)
            {
                <p class="text-center mt-3">Loading downloads...</p>
                <div class="text-center">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            }
            else if (selectedDownloadType == "nextgen" && NextGenDownloadInfos.Count > 0)

            {
                @foreach (var downloadInfo in NextGenDownloadInfos)
                {
                    <div class="row mt-3 download-item-card">
                        <div class="download-item-details col-9">
                            <h3>Version: @downloadInfo.Revision</h3>
                            <p><strong>Release Date:</strong> @downloadInfo.ReleaseDate.ToShortDateString()</p>
                            <p><strong>Description:</strong> @downloadInfo.Title</p>
                            <p><strong>Version:</strong> @downloadInfo.Version</p>
                            <p><strong>GitHub Issue:</strong> <a href="@GetNextGenIssueLink(downloadInfo.Issue)" target="_blank">@downloadInfo.Issue</a></p>
                        </div>

                        <div class="download-actions col-3 g-3">
                            <button class="btn btn-primary pill-button-primary w-100 mb-2" @onclick='() => OnNextGenDownloadClicked(downloadInfo, downloadInfo.DownloadLinkWindows, "windows")'>
                                <span class="os-icon os-icon-windows" aria-hidden="true"></span>Download for Windows
                            </button>
                            <button class="btn btn-primary pill-button-primary w-100 mb-2" @onclick='() => OnNextGenDownloadClicked(downloadInfo, downloadInfo.DownloadLinkMacOS, "macos")'>
                                <span class="os-icon os-icon-macos" aria-hidden="true"></span>Download for MacOS
                            </button>
                            <button class="btn btn-primary pill-button-primary w-100 mb-2" @onclick='() => OnNextGenDownloadClicked(downloadInfo, downloadInfo.DownloadLinkDebian, "linux-debian")'>
                                <span class="os-icon os-icon-linux" aria-hidden="true"></span>Download for Linux (Debian)
                            </button>
                        </div>
                    </div>
                }
            }
            else if (selectedDownloadType == "classic" && ClassicDownloadInfos.Count > 0)
            {
                @foreach (var classicInfo in ClassicDownloadInfos)
                {
                    <div class="row mt-3 download-item-card">
                        <div class="download-item-details col-9">
                            <h3>Revision: @(classicInfo.RevisionNumber?.ToString() ?? "N/A")</h3>
                            <p><strong>Date:</strong> @((classicInfo.FinishTime ?? classicInfo.StartTime)?.ToShortDateString() ?? "N/A")</p>
                            <p><strong>Description:</strong> @classicInfo.Title</p>
                            <p><strong>Author:</strong> @classicInfo.Author</p>
                            <p><strong>GitHub Issue:</strong> <a href="@GetClassicIssueLink(classicInfo.BugID)" target="_blank" rel="noopener noreferrer">@classicInfo.BugID</a></p>
                        </div>

                        <div class="download-actions col-3 g-3">
                            @if (classicInfo.RevisionNumber is int revision)
                            {
                                <button class="btn btn-primary pill-button-primary w-100 mb-2" @onclick="() => OnClassicDownloadClicked(classicInfo, revision)">
                                    <span class="os-icon os-icon-windows" aria-hidden="true"></span>Download APSIM Classic
                                </button>
                            }
                            <button type="button" class="btn btn-primary pill-button-primary w-100 mb-2" @onclick="() => OpenInNewTab(GetClassicIssueLink(classicInfo.BugID))">
                                <span class="os-icon os-icon-github" aria-hidden="true"></span>More Info
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center mt-3">No downloads are currently available for this selection.</p>
            }
            </div>
        }
    </div>
</div>

<CustomModal Title="@modalTitle" @bind-IsOpen="showModal">
    @modalMessage
</CustomModal>

@code
{
    private bool showModal = false;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;
    private bool hasValidToken;
    private bool isTokenValidationInProgress = true;
    private bool isSelectionLoading;
    private string selectedDownloadType = "nextgen";
    private string? accessToken;

    private List<APSIMClassicDownloadInfo> ClassicDownloadInfos { get; set; } = new List<APSIMClassicDownloadInfo>();
    private List<APSIMNextGenDownloadInfo> NextGenDownloadInfos { get; set; } = new List<APSIMNextGenDownloadInfo>();

    protected override async Task OnParametersSetAsync()
    {
        // Always reset visibility and data before any async work to avoid flashing stale downloads.
        isTokenValidationInProgress = true;
        hasValidToken = false;
        NextGenDownloadInfos.Clear();
        ClassicDownloadInfos.Clear();

        try
        {
            var token = GetTokenFromQueryString();
            if (!string.IsNullOrWhiteSpace(token))
            {
                // Keep token in state for compatibility with existing flow.
                DownloadAccessState.SetToken(token);
            }
            else
            {
                token = DownloadAccessState.GetToken();
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                Logger.LogWarning("Download page opened without an access token in query string or state.");
                hasValidToken = false;
                return;
            }

            accessToken = token;

            var tokenValidationResponse = await WebApiUtility.ValidateDownloadTokenAsync(token);
            hasValidToken = tokenValidationResponse?.IsValid == true;

            if (!hasValidToken)
            {
                Logger.LogWarning("Invalid or expired download token was provided.");
                return;
            }

            await LoadDownloadsForSelectionAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred while validating the download token.");
            hasValidToken = false;
        }
        finally
        {
            isTokenValidationInProgress = false;
        }
    }

    private static string GetNextGenIssueLink(int issueNumber)
    {
        return $"https://github.com/APSIMInitiative/ApsimX/issues/{issueNumber}";
    }

    private static string GetClassicIssueLink(long bugId)
    {
        return $"https://github.com/APSIMInitiative/APSIM710/issues/{bugId}";
    }

    private async Task OnDownloadTypeChanged(ChangeEventArgs e)
    {
        var nextType = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(nextType) || (nextType != "nextgen" && nextType != "classic"))
        {
            return;
        }

        selectedDownloadType = nextType;
        await LoadDownloadsForSelectionAsync();
    }

    private async Task LoadDownloadsForSelectionAsync()
    {
        isSelectionLoading = true;
        try
        {
            if (selectedDownloadType == "nextgen")
            {
                NextGenDownloadInfos = await APSIMBuildsAPIUtility.GetAPSIMNextGenBuildsListAsync() ?? new List<APSIMNextGenDownloadInfo>();
            }
            else
            {
                ClassicDownloadInfos = await APSIMBuildsAPIUtility.GetAPSIMClassicBuildsListAsync() ?? new List<APSIMClassicDownloadInfo>();
            }
        }
        finally
        {
            isSelectionLoading = false;
        }
    }

    private string? GetTokenFromQueryString()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (string.IsNullOrWhiteSpace(uri.Query))
        {
            return null;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("token", out var tokenValue))
        {
            return null;
        }

        var token = tokenValue.ToString();
        return string.IsNullOrWhiteSpace(token) ? null : token;
    }

    private void ShowModal(string title, string message)
    {
        modalTitle = title;
        modalMessage = message;
        showModal = true;
    }

    private async Task OpenInNewTab(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
    }

    private async Task OnNextGenDownloadClicked(APSIMNextGenDownloadInfo downloadInfo, string? downloadUrl, string platform)
    {
        if (string.IsNullOrWhiteSpace(downloadUrl))
        {
            return;
        }

        var version = string.IsNullOrWhiteSpace(downloadInfo.Version)
            ? $"Revision {downloadInfo.Revision}"
            : downloadInfo.Version;

        await TrackDownloadEventAsync("nextgen", version, platform, downloadUrl);
        NavigationManager.NavigateTo(downloadUrl, true);
    }

    private async Task OnClassicDownloadClicked(APSIMClassicDownloadInfo classicInfo, int revision)
    {
        var downloadUrl = APSIMBuildsAPIUtility.GetClassicBuildDownloadLink(revision);
        await TrackDownloadEventAsync("classic", $"Revision {revision}", "windows", downloadUrl);
        await OpenInNewTab(downloadUrl);
    }

    private async Task TrackDownloadEventAsync(string downloadType, string version, string platform, string downloadUrl)
    {
        var token = accessToken;
        if (string.IsNullOrWhiteSpace(token))
        {
            token = DownloadAccessState.GetToken();
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            Logger.LogWarning("Unable to record download event because access token was unavailable.");
            return;
        }

        try
        {
            var tracked = await WebApiUtility.RecordDownloadEventAsync(new DownloadEventRequest
            {
                Token = token,
                DownloadType = downloadType,
                Version = version,
                Platform = platform,
                DownloadUrl = downloadUrl
            });

            if (!tracked)
            {
                Logger.LogWarning("Download event tracking request was not successful for {DownloadType} {Version}.", downloadType, version);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to record download event for {DownloadType} {Version}.", downloadType, version);
        }
    }



}