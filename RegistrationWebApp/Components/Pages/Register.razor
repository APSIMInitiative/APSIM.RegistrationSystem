@using RegistrationShared.Models
@using RegistrationShared.Enums
@using RegistrationWebApp.Components.Layout.CustomLayout;
@using RegistrationWebApp.Components.Classes.Utilities;
@using System.Runtime.CompilerServices
@using System.Diagnostics.Eventing.Reader
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Utilities
@using RegistrationWebApp.Components.Classes;
@using Microsoft.Extensions.Logging
@using RegistrationWebApp.Components.Utilities.Models

@namespace RegistrationWebApp.Components.Pages
@page "/register"
@*This page allows users to select a product licence and register for it. The content of the page changes based on the selected product.*@
@rendermode InteractiveServer
@inject ILogger<Register> Logger
@inject WebApiUtility webApiUtility

<PageTitle>Pick Product Licence</PageTitle>
<h2 class="text-center m-4">Register for a Product Licence</h2>
<div class="row">
    <div class="col col-12 mb-4 mt-4">
        <div  class="row mb-4 mt-4">
            <div id="licence-decision-table" class="col col-8 mb-4 mt-4 mx-auto">
                <h3>Licencing Summary Table</h3>
                <p>This table provides and compares the main considerations for the three licencing pathways.</p>
                <table class="table table-bordered table-hover table-striped border-light border border-3">
                    <thead>
                        <tr>
                            <th scope="col" class="w-25"></th>
                            <th scope="col" class="w-25">General Use Licence</th>
                            <th scope="col" class="w-25">Special Use Licence - Type 1</th>
                            <th scope="col" class="w-25">Special Use Licence - Type 2</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Intended Use</strong></td>
                            <td>For educational purposes, for personal learning, or for public good research.</td>
                            <td>For commerical purposes</td>
                            <td>For commerical purposes</td>
                        </tr>
                        <tr>
                            <td><strong>Intellectual Property Ownership</strong></td>
                            <td>APSIM Initiative owns new IP</td>
                            <td>APSIM Initiative owns new IP</td>
                            <td>Licencee(s) own new IP</td>
                        </tr>
                        <tr>
                            <td><strong>Cost</strong></td>
                            <td>Free</td>
                            <td>Fee determined by annual turnover ($AU 3,638 - 30,319 per year) </td>
                            <td>Pricing structures are discussed case-by-case (~$AU 10,000 - 90,000 per year)</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="align-middle">
                                <a href="/validate" class="btn btn-primary">Register for a General Use Licence</a>
                            </td>
                            <td class="align-middle">
                                <a href="/special-registration?type=1" class="btn btn-primary">Register for a Special Use Licence - Type 1</a>
                            </td>
                            <td class="align-middle">
                                <a href="/special-registration?type=2" class="btn btn-primary">Register for a Special Use Licence - Type 2</a>
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>




