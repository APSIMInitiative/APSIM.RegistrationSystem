@using RegistrationShared.Models
@using RegistrationShared.Enums
@using RegistrationWebApp.Components.Classes.Utilities
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Layout.CustomLayout
@using RegistrationWebApp.Components.Utilities

@namespace RegistrationWebApp.Components.Pages
@page "/admin/"
@rendermode InteractiveServer
@inject WebApiUtility WebApiUtility
@inject ILogger<Admin> Logger
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Registration Admin</PageTitle>

<div hidden="@isAuthenticated">
    <div class="login-container container mt-4">
        <div class="row justify-content-center">
            <div class="login-form-div col-12 col-md-6 col-lg-4 border rounded p-4 text-start">
                <form @onsubmit="AuthenticateAdminAsync" @onsubmit:preventDefault>
                    <p class="mb-3">Enter the admin password to continue.</p>
                    <label for="adminPassword" class="form-label">Password</label>
                    <input id="adminPassword" type="password" class="form-control" @bind="adminPasswordInput" />
                    @if (!string.IsNullOrWhiteSpace(passwordErrorMessage))
                    {
                        <div class="text-danger mt-2">@passwordErrorMessage</div>
                    }
                    <button type="submit" class="btn btn-success rounded-pill pill-button mt-3">Unlock Admin</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row m-3" hidden="@(!isAuthenticated)">
    <div class="col-12 col-md-10 m-3">
        <div class="row licence-row mt-4 text-center">
            <div class="col licence-col col-12 col-md-12">
                <h2 class="text-center">Licenses</h2>
                <p class="text-center">Here you can manage licences through their lifecycle</p>
                <div class="row row-lg-12 p-3">
                    <div class="row">
                        <div class="col-4 d-flex align-items-start">
                            <button class="btn btn-success rounded-pill pill-button mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="false" aria-controls="collapseUsers">
                                Show/Hide Users
                            </button>
                        </div>
                    </div>
                    <div class="collapse show user-regos-col col-lg-12 col-md-12 col-sm-12 m-3" id="collapseUsers">
                        <h3>User Registrations</h3>
                        <table class="table table-sm table-striped table-bordered table-hover table-responsive">
                            <thead class="table-success">
                                <tr>
                                    <th>Email</th>
                                    <th>Licence Status</th>
                                    <th>Date Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (User registration in users.
                                    OrderByDescending(r => r.DateCreated))
                                {
                                    <tr>
                                        <td>@registration.Email</td>
                                        <td>@registration.LicenceStatus.GetDescription()</td>
                                        <td>@registration.DateCreated.ToShortDateString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row">
                        <div class="col-4 d-flex align-items-start">
                            <button class="btn btn-success rounded-pill pill-button mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOrganisations" aria-expanded="false" aria-controls="collapseOrganisations">
                                Show/Hide Organisations
                            </button>
                        </div>
                    </div>

                    <div class="collapse show org-reg-col col-lg-12 col-md-12 col-sm-12 m-3 overflow-auto" id="collapseOrganisations">
                        <h3>Organisations</h3>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered table-hover">
                                <thead class="table-success">
                                    <tr>
                                        <th>Organisation Name</th>
                                        <th>Contact Name</th>
                                        <th>Contact Email</th>
                                        <th>Contact Phone</th>
                                        <th>Contact Address</th>
                                        <th>Licence Pathway</th>
                                        <th>Annual Turnover</th>
                                        <th>Application Date</th>
                                        <th>Registered Members</th>
                                        <th>Licence Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Organisation organisation in organisations.OrderByDescending(o => o.DateCreated))
                                    {
                                        <tr>
                                            <td>@organisation.Name</td>
                                            <td>@organisation.ContactName</td>
                                            <td>@organisation.ContactEmail</td>
                                            <td>@organisation.ContactPhone</td>
                                            <td>@organisation.ContactAddress</td>
                                            <td>@organisation.LicencePathway.GetDescription()</td>
                                            <td>@organisation.AnnualTurnover.GetDescription()</td>
                                            <td>@organisation.DateCreated.ToShortDateString()</td>
                                            <td>@organisation.Users.Count()</td>
                                            <td>@organisation.LicenceStatus.GetDescription()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="member-org-row row mt-4 text-center">
            <div class="col-12 col-lg-12 col-md-6">
                <h2>Member Organisations</h2>
                <p>Here you can manage member organisations and their associated members</p>
                <div class="add-member-org-row row gx-4 gy-4">
                    <div class="add-member-col col-12 col-lg-6">
                        <div class="member-org-panel h-100">
                            <h3>Add New Member Organisation</h3>
                            <EditForm Model="MemberOrganisation" OnValidSubmit="HandleNewMemberOrganisationSubmit">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                    <label for="organisationName" class="form-label">Organisation Name</label>
                                    <InputText id="organisationName" class="form-control" @bind-Value="MemberOrganisation.Name" 
                                        placeholder="Enter organisation name e.g. CSIRO" />
                                    <InputText id="contactName" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactName" 
                                        placeholder="Enter contact name e.g. John Doe" />
                                    <InputText id="contactEmail" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactEmail" 
                                        placeholder="Enter contact email e.g. john.doe@example.com" />
                                    <InputText id="contactPhone" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactPhone" 
                                        placeholder="Enter contact phone e.g. +61 123 456 789" />
                                    <InputText id="contactAddress" class="form-control mt-2" @bind-Value="MemberOrganisation.ContactAddress" 
                                        placeholder="Enter contact address e.g. 123 Main St, City, Country" />
                                    <InputSelect id="licencePathway" class="form-select mt-2" @bind-Value="MemberOrganisation.LicencePathway">
                                        <option value="@LicencePathway.APSIMInitiativeMember" selected>@LicencePathway.APSIMInitiativeMember.GetDescription()</option>
                                    </InputSelect>
                                    <InputSelect id="annualTurnover" class="form-select mt-2" @bind-Value="MemberOrganisation.AnnualTurnover">
                                        <option value="@AnnualTurnover.BelowTwoMillion" selected>@AnnualTurnover.BelowTwoMillion.GetDescription()</option>
                                    </InputSelect>
                                    <InputSelect id="licenceStatus" class="form-select mt-2" @bind-Value="MemberOrganisation.LicenceStatus">
                                        <option value="@OrganisationLicenceStatus.Active" selected>@OrganisationLicenceStatus.Active.GetDescription()</option>
                                    </InputSelect>
                                    <button type="submit" class="btn btn-success rounded-pill pill-button mt-4">Add Member Organisation</button>
                            </EditForm>
                        </div>
                    </div>
                    <div class="existing-member-col col-12 col-lg-6">
                        <div class="member-org-panel h-100">
                            <h3>Existing Member Organisations</h3>
                            <table class="table table-sm table-striped table-bordered table-hover">
                                <thead class="table-success">
                                    <tr>
                                        <th>Organisation Name</th>
                                        <th>Date Created</th>
                                        <th>No. Registered Members</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var memberOrg in organisations 
                                        .Where(o => o.LicencePathway == 
                                        LicencePathway.APSIMInitiativeMember))
                                    {
                                        <tr>
                                            <td>@memberOrg.Name</td>
                                            <td>@memberOrg.DateCreated.ToShortDateString()</td>
                                            <td>@memberOrg.Users.Count()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="manage-special-org-row row mt-4 mb-4 text-center">
            <div class="col-12">
                <h2>Manage Special Licence Organisations</h2>
                <p>Choose a special use organisation, edit its values, and submit updates to the API.</p>
            </div>
            <div class="col-12">
                <div class="member-org-panel text-start">
                    <label for="specialOrganisationSelector" class="form-label fw-semibold">Special Use Organisation</label>
                    <select id="specialOrganisationSelector" class="form-select" value="@selectedSpecialOrganisationId" @onchange="OnSpecialOrganisationSelectionChanged">
                        <option value="">-- Select a special use organisation --</option>
                        @foreach (var organisation in SpecialUseOrganisations)
                        {
                            <option value="@organisation.Id">@organisation.Name</option>
                        }
                    </select>

                    @if (SpecialOrganisation is not null)
                    {
                        <EditForm Model="SpecialOrganisation" OnValidSubmit="HandleSpecialOrganisationSubmit" class="mt-4">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <label for="specialOrganisationName" class="form-label">Organisation Name</label>
                            <InputText id="specialOrganisationName" class="form-control" @bind-Value="SpecialOrganisation.Name" placeholder="Organisation name" />

                            <label for="specialContactName" class="form-label mt-2">Contact Name</label>
                            <InputText id="specialContactName" class="form-control" @bind-Value="SpecialOrganisation.ContactName" placeholder="Contact name" />
                            <label for="specialContactEmail" class="form-label mt-2">Contact Email</label>
                            <InputText id="specialContactEmail" class="form-control" @bind-Value="SpecialOrganisation.ContactEmail" placeholder="Contact email" />
                            <label for="specialContactPhone" class="form-label mt-2">Contact Phone</label>
                            <InputText id="specialContactPhone" class="form-control" @bind-Value="SpecialOrganisation.ContactPhone" placeholder="Contact phone" />
                            <label for="specialContactAddress" class="form-label mt-2">Contact Address</label>
                            <InputText id="specialContactAddress" class="form-control" @bind-Value="SpecialOrganisation.ContactAddress" placeholder="Contact address" />

                            <label for="specialOrganisationEmails" class="form-label mt-3">Organisation Emails/Domains</label>
                            <InputTextArea id="specialOrganisationEmails" class="form-control" rows="3" @bind-Value="specialOrganisationEmailsText" />
                            <div class="form-text">Use comma, semicolon, or newline separators (example: *@@domain.org).</div>

                            <label for="specialLicencePathway" class="form-label mt-2">Licence Pathway</label>
                            <InputSelect id="specialLicencePathway" class="form-select" @bind-Value="SpecialOrganisation.LicencePathway">
                                @foreach (var licencePathway in Enum.GetValues<LicencePathway>())
                                {
                                    <option value="@licencePathway">@licencePathway.GetDescription()</option>
                                }
                            </InputSelect>

                            <label for="specialAnnualTurnover" class="form-label mt-2">Annual Turnover</label>
                            <InputSelect id="specialAnnualTurnover" class="form-select" @bind-Value="SpecialOrganisation.AnnualTurnover">
                                @foreach (var annualTurnover in Enum.GetValues<AnnualTurnover>())
                                {
                                    <option value="@annualTurnover">@annualTurnover.GetDescription()</option>
                                }
                            </InputSelect>

                            <label for="specialLicenceStatus" class="form-label mt-2">Licence Status</label>
                            <InputSelect id="specialLicenceStatus" class="form-select" @bind-Value="SpecialOrganisation.LicenceStatus">
                                @foreach (var licenceStatus in Enum.GetValues<OrganisationLicenceStatus>())
                                {
                                    <option value="@licenceStatus">@licenceStatus.GetDescription()</option>
                                }
                            </InputSelect>

                            <div>
                                <button type="submit" class="btn btn-success rounded-pill pill-button mt-3">Update Special Organisation</button>
                            </div>

                        </EditForm>
                    }
                    else
                    {
                        <p class="mt-3 mb-0 text-muted">Select an organisation to load editable details.</p>
                    }
                </div>
            </div>
        </div>
    </div>


    <CustomModal @bind-IsOpen="isModalOpen" Title="@modalTitle">
        @modalMessage
    </CustomModal>
</div>

@code{

    private bool isModalOpen = false;
    private bool isAuthenticated = false;
    private string adminPasswordInput = string.Empty;
    private string configuredAdminPassword = string.Empty;
    private string passwordErrorMessage = string.Empty;
    private string modalTitle = string.Empty;
    private string modalMessage = string.Empty;

    /// <summary>
    /// This property represents a member organisation that can be added through the admin interface.
    /// </summary>
    /// <remarks>
    /// The default values for the LicencePathway, AnnualTurnover, and LicenceStatus properties
    /// are set to APSIMInitiativeMember, BelowTwoMillion, and Active respectively to ensure values are preselected
    /// properly.
    /// </remarks>
    private Organisation MemberOrganisation { get; set; } = new Organisation{
        LicencePathway = LicencePathway.APSIMInitiativeMember,
        AnnualTurnover = AnnualTurnover.BelowTwoMillion,
        LicenceStatus = OrganisationLicenceStatus.Active
    };

    private Organisation? SpecialOrganisation { get; set; }
    private string selectedSpecialOrganisationId = string.Empty;
    private string specialOrganisationEmailsText = string.Empty;

    private List<User> users = new List<User>();
    private List<Organisation> organisations = new List<Organisation>();

    private List<Organisation> SpecialUseOrganisations => organisations
        .Where(o => o.LicencePathway == LicencePathway.TypeOne || o.LicencePathway == LicencePathway.TypeTwo)
        .OrderBy(o => o.Name)
        .ToList();

    private async Task AuthenticateAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(configuredAdminPassword))
        {
            passwordErrorMessage = "Admin password is not configured. Please contact an administrator.";
            return;
        }

        if (!string.Equals(adminPasswordInput, configuredAdminPassword, StringComparison.Ordinal))
        {
            passwordErrorMessage = "Incorrect password.";
            return;
        }

        isAuthenticated = true;
        passwordErrorMessage = string.Empty;
        adminPasswordInput = string.Empty;
        await LoadAdminDataAsync();
    }

    /// <summary>
    /// Handle the submission of a new member organisation. 
    /// This method is called when the form for adding a new member organisation is submitted.
    /// </summary>
    /// <returns></returns>
    private async Task HandleNewMemberOrganisationSubmit()
    {
        Logger.LogInformation($"New Member Organisation Submitted: {MemberOrganisation.Name}");
        if (MemberOrganisation.LicencePathway != LicencePathway.APSIMInitiativeMember)
        {
            Logger.LogWarning(
                $"Attempted to add member organisation with invalid licence pathway: {MemberOrganisation.LicencePathway}"
            );
            ShowModal("Error", 
            "Invalid licence pathway.Member organisations must have the 'APSIM Initiative Member' licence pathway.");
            return;
        }
        List<string>emailsWildCard = new List<string>{ $"*@{MemberOrganisation.ContactEmail.Split('@').Last()}" };
        MemberOrganisation.Emails = emailsWildCard;
        HttpResponseMessage response = await WebApiUtility.AddOrganisationAsync(MemberOrganisation);
        if (response.IsSuccessStatusCode)
        {
            Logger.LogInformation("Member organisation added successfully.");
            MemberOrganisation = new Organisation(); // Clear the form
            ShowModal("Success", "Member organisation added successfully.");
        }
        else
        {
            Logger.LogError($"Failed to add member organisation. Status Code: {response.StatusCode}");
            ShowModal("Error", $"Failed to add member organisation {MemberOrganisation.Name}. Status Code: {response.StatusCode}");
        }
        NavigationManager.Refresh(true); // Refresh the page to show the updated list of organisations
    }

    // This method is called when the component is initialized. 
    // It retrieves data required for the admin page, such as the list of 
    // registrations and member organisations, and handles any errors 
    // that may occur during data retrieval.
    protected override Task OnInitializedAsync()
    {
        configuredAdminPassword = Configuration["Admin:Password"] ?? string.Empty;
        if (string.IsNullOrWhiteSpace(configuredAdminPassword))
            Logger.LogWarning("Admin password is not configured. The admin page cannot be unlocked.");

        return Task.CompletedTask;
    }

    private async Task LoadAdminDataAsync()
    {
        try
        {
            Logger.LogInformation("Admin page authenticated. Fetching registrations and member organisations.");
            users = await WebApiUtility.GetUsersAsync();
            organisations = await WebApiUtility.GetOrganisationsAsync();

            if (!string.IsNullOrWhiteSpace(selectedSpecialOrganisationId))
            {
                var selected = organisations.FirstOrDefault(o => o.Id.ToString() == selectedSpecialOrganisationId);
                SpecialOrganisation = selected is null ? null : CloneOrganisation(selected);
                if (selected is null)
                {
                    selectedSpecialOrganisationId = string.Empty;
                    specialOrganisationEmailsText = string.Empty;
                }
                else
                {
                    specialOrganisationEmailsText = string.Join(Environment.NewLine, SpecialOrganisation!.Emails);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred while fetching data for the admin page.");
            ShowModal("Error", "An error occurred while fetching data. Please try again later.");
        }
    }

    /// <summary>
    /// Displays a modal dialog with the specified title and message. This method sets the modal's title and message,
    /// and opens the modal.
    /// </summary>
    /// <param name="title">The title of the modal dialog.</param>
    /// <param name="message">The message to be displayed in the modal dialog.</param>
    private void ShowModal(string title, string message)
    {
        modalTitle = title;
        modalMessage = message;
        isModalOpen = true;
    }

    private void OnSpecialOrganisationSelectionChanged(ChangeEventArgs e)
    {
        selectedSpecialOrganisationId = e.Value?.ToString() ?? string.Empty;
        var selected = SpecialUseOrganisations.FirstOrDefault(o => o.Id.ToString() == selectedSpecialOrganisationId);
        SpecialOrganisation = selected is null ? null : CloneOrganisation(selected);
        specialOrganisationEmailsText = SpecialOrganisation is null
            ? string.Empty
            : string.Join(Environment.NewLine, SpecialOrganisation.Emails);
    }

    private static List<string> ParseOrganisationEmails(string emailsText)
    {
        return emailsText
            .Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(value => value.Trim())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static Organisation CloneOrganisation(Organisation organisation)
    {
        return new Organisation
        {
            Id = organisation.Id,
            Name = organisation.Name,
            Emails = organisation.Emails.ToList(),
            LicenceStatus = organisation.LicenceStatus,
            ContactName = organisation.ContactName,
            ContactEmail = organisation.ContactEmail,
            ContactPhone = organisation.ContactPhone,
            ContactAddress = organisation.ContactAddress,
            LicencePathway = organisation.LicencePathway,
            AnnualTurnover = organisation.AnnualTurnover,
            DateCreated = organisation.DateCreated,
            Users = organisation.Users.ToList()
        };
    }

    private async Task HandleSpecialOrganisationSubmit()
    {
        if (SpecialOrganisation is null)
        {
            ShowModal("Error", "Please select a special use organisation to update.");
            return;
        }

        SpecialOrganisation.Emails = ParseOrganisationEmails(specialOrganisationEmailsText);
        if (SpecialOrganisation.Emails.Count == 0)
        {
            ShowModal("Error", "At least one organisation email/domain is required.");
            return;
        }

        HttpResponseMessage response = await WebApiUtility.UpdateOrganisationAsync(SpecialOrganisation);
        if (response.IsSuccessStatusCode)
        {
            ShowModal("Success", $"Organisation '{SpecialOrganisation.Name}' updated successfully.");
            await LoadAdminDataAsync();
            return;
        }

        Logger.LogError("Failed to update organisation {OrganisationId}. Status code: {StatusCode}", SpecialOrganisation.Id, response.StatusCode);
        ShowModal("Error", $"Failed to update organisation '{SpecialOrganisation.Name}'. Status Code: {response.StatusCode}");
    }

}