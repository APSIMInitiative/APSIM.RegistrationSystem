@using RegistrationWebApp.Components.LayoutObjects

@namespace RegistrationWebApp.Components.Layout.CustomLayout

<div class="card product-box p-3 h-100" >
    @* <div class="card-header text-center">
        <h3 class="card-title">@Product.Name</h3>
    </div> *@
    <img src="@Product.ImageUrl" alt="@Product.Name" class="card-img-top w-25 mx-auto d-block" />
    <div class="card-body align-items-end h-100">
        @Product.Description
    </div>
    <div class="product-footer text-center mt-auto">
        <NavLink href="@Product.Href" class="btn btn-success rounded-pill m-2 pill-button">
            @Product.FirstButtonText

        </NavLink>
        @if (!string.IsNullOrEmpty(Product.SecondHref) && !string.IsNullOrEmpty(Product.SecondButtonText))
        {
            <NavLink href="@Product.SecondHref" target="_blank" class="btn btn-primary rounded-pill m-2 pill-button-primary">
                @Product.SecondButtonText
                <svg class="external-link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; margin-left: 6px; vertical-align: -2px;">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
            </NavLink>
        }
    </div>
</div>

@code{
    [Parameter]
    public required Product Product { get; set; }

}