@using RegistrationShared.Models
@using RegistrationShared.Enums
@using RegistrationWebApp.Components.Layout.CustomLayout;
@using RegistrationWebApp.Components.Classes.Utilities;
@using System.Runtime.CompilerServices
@using System.Diagnostics.Eventing.Reader
@using RegistrationWebApp.Components.Layout.CustomLayout.BootstrapHelpers
@using RegistrationWebApp.Components.Utilities
@using RegistrationWebApp.Components.Classes;
@using Microsoft.Extensions.Logging
@using RegistrationWebApp.Components.Utilities.Models

@namespace RegistrationWebApp.Components.Pages
@page "/register/{ProductId?}"
@*This page allows users to select a product licence and register for it. The content of the page changes based on the selected product.*@
@rendermode InteractiveServer
@inject ILogger<Register> Logger
@inject WebApiUtility webApiUtility

<PageTitle>Pick Product Licence</PageTitle>
<div class="row mt-4">
    <div class="col">
        <h1 class="text-center">@PageHeading</h1>
        <div class="row mt-4 g-3">
            <div class="col-lg-4 offset-lg-2 col-md-6">
                <DotPointCard 
                    Title="Using APSIM for learning or research purposes?" 
                    Description=@GeneralDotPoints
                    MainButtonText="Register for General Use Licence"
                    BodyButtonLink="https://www.apsim.info/registration/general-use-licence/"
                    BodyButtonText="General Use Licence details"
                />
            </div>
            <div class="col-lg-4 col-md-6">
                <DotPointCard 
                    Title="Using APSIM for commercial purposes?" 
                    Description=@SpecialDotPoints
                    MainButtonText="Register for Special Use Licence"
                    BodyButtonLink="https://www.apsim.info/download-apsim/"
                    BodyButtonText="Special Use Licence details"
                />
            </div>
        </div>
    </div>
</div>

@* Start of special use choice boxes *@
<div class="special-use-licence-choice-row row mt-4 mb-4">
    @if (ProductId is not null)
    {
    <div class="col-8 offset-2">
        <div class="row text-center">
            <h3>Not quite sure which one to pick? </h3>
            <h4>Go through the steps below.</h4>
        </div>
        <DecisionCard 
            StepNumber="1"
            StepQuestionText="Do you intend to use APSIM for commercial purposes?"
            Description=@StepOneDescription
            ToggleYes="ToggleImprovementsShared"
            ToggleNo="ToggleGeneral"
            ToggleThirdOption="ToggleAll"
            IsVisible="@isCommercialUseDecisionCardVisible"
        />
        <DecisionCard 
            StepNumber="2"
            StepQuestionText="Do you intend to share any modifications made back to the APSIM Initiative?"
            Description=@StepFourDescription
            DecisionOneText="Yes"
            DecisionTwoText="No"
            ToggleYes="ToggleSpecialSharingYes"
            ToggleNo="ToggleSpecial"
            ToggleThirdOption="ToggleAll"
            IsVisible="@areImprovementsSharedDecisionCardVisible"
        />
    </div>
    }
    @if (ProductId is null)
    {
        <div class="col text-center">
            <h3>Please return to the home page to <a href="/">select a product</a>.</h3>
        </div>
    }
</div>


@* // Special Use Registration Form *@
<div class="register-row row mt-4" hidden="@(!isSpecialUseRegistrationVisible)">
    <div class="col text-center">
        <div class="special-use-licence-choice-row row mt-4">
            <div class="special-use-col col-md-6 offset-md-3 mb-4">
                <h2 class="text-center">Special Use Registration</h2>
                <div class="alert alert-info " role="alert">
                    <p>Based on your selections a licence pathway has been selected for you.</p>
                </div>
                <EditForm Model="@organisation" OnValidSubmit="() => SubmitOrganisationApplication(organisation)" FormName="specialUseRegistrationForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="special-use-form-row row mb-3">
                        <InputText class="form-control mb-2" Placeholder="*Contact Person's Email" @bind-Value="organisation!.ContactEmail" />
                        <ValidationMessage For="@(() => organisation.ContactEmail)" />
                        <InputText class="form-control mb-2" Placeholder="*Contact Person's Name" @bind-Value="organisation!.ContactName" />
                        <ValidationMessage For="@(() => organisation.ContactName)" />
                        <InputText class="form-control mb-2" Placeholder="Contact Phone" @bind-Value="organisation!.ContactPhone" />
                        <ValidationMessage For="@(() => organisation.ContactPhone)" />
                        <InputText class="form-control mb-2" Placeholder="*Organisation Name" @bind-Value="organisation!.Name" />
                        <ValidationMessage For="@(() => organisation.Name)" />
                        <InputText class="form-control mb-2" Placeholder="*Organisation Address" @bind-Value="organisation!.ContactAddress" />
                        <ValidationMessage For="@(() => organisation.ContactAddress)" />
                        <InputSelect class="form-control mb-2" @bind-Value="organisation!.LicencePathway">
                            <option value=""disabled>-- Select Licence Pathway --</option>
                            @if (SpecialUseStep <= 3)
                            {
                                <option value="@LicencePathway.TypeOne" selected disabled>@LicencePathway.TypeOne.GetDescription()</option>
                                <option value="@LicencePathway.TypeTwo" disabled>@LicencePathway.TypeTwo.GetDescription()</option>
                            }
                            @if (SpecialUseStep == 4)
                            {
                                <option value="@LicencePathway.TypeOne" disabled>@LicencePathway.TypeOne.GetDescription()</option>
                                <option value="@LicencePathway.TypeTwo" disabled selected>@LicencePathway.TypeTwo.GetDescription()</option>
                            }
                        </InputSelect >
                        <InputSelect class="form-control mb-2" @bind-Value="organisation!.AnnualTurnover">
                            @foreach (var annualTurnover in Enum.GetValues<AnnualTurnover>())
                            {
                                <option value="@annualTurnover">@annualTurnover.GetDescription()</option>
                            }
                            <option value="" selected disabled>*-- Select Annual Turnover Range --</option>
                        </InputSelect >
                        <InputSelect class="form-control mb-2 mt-2" hidden @bind-Value="organisation!.LicenceStatus">
                            <option value="@OrganisationLicenceStatus.Pending" selected disabled>@OrganisationLicenceStatus.Pending.GetDescription()</option>
                        </InputSelect >

                        <PdfViewer PdfUrl="/Documents/APSIM_Special_Use_Licence.pdf"/>
                    </div>
                    <p class="mb-2">By clicking submit I have read and agree to the Special Use licence terms.</p>
                    <p>
                        <em>Please note that final licence classification is confirmed by the APSIM Initiative.</em>
                    </p>
                    <div class="row w-25 mx-auto text-center">
                        <button type="submit" class="btn btn-success pill-button rounded-pill">Submit Application</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>


<div class="general-registration-form-row row " hidden="@(!isGeneralUseRegistrationVisible)">
    <div class="general-use-col col col-md-6 offset-md-3 mt-5 mb-5">
        <h2 class="text-center">General Use Registration</h2>
        <EditForm Model="@generalUseRegistration" OnValidSubmit="() => SubmitUserApplication(generalUseRegistration)" FormName="generalUseRegistrationForm">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="general-use-form-row row mb-3 text-center">
                <InputText class="form-control mb-2" Placeholder="Email" @bind-Value="generalUseRegistration!.Email" />
                <ValidationMessage For="@(() => generalUseRegistration.Email)" />
                <InputSelect hidden @bind-Value="generalUseRegistration!.LicenceStatus" 
                    class="form-control mb-2">
                    <option value="@UserLicenceStatus.Pending" selected disabled>
                        @UserLicenceStatus.General.GetDescription()
                    </option>
                </InputSelect>
                <PdfViewer PdfUrl="/Documents/APSIM_General_Use_Licence.pdf"/>
            </div>
            <Row CustomRowClasses="text-center">
                <p> By clicking submit I have read and agree to the General Use licence terms.</p>
                <Col CustomColClasses="w-25 mx-auto">
                    <button type="submit" class="btn btn-success pill-button rounded-pill">Submit Application</button>
                </Col>
            </Row>
        </EditForm>
    </div>
</div>

<CustomModal @bind-IsOpen="showModal" Title="@modalTitle">
    @* Shows the response message from a registration submission *@
    @modalMessage
</CustomModal>

@code {

    // Code for handling form submission and any additional logic can be added here.
    [Parameter]
    public string? ProductId { get; set; }

    public int SpecialUseStep { get; set; } = 0;

    public string PageHeading {
        get => ProductId switch
        {
            "nextgen" => "APSIM Next Generation Registration",
            "classic" => "APSIM Classic Registration",
            _ => "Pick a Product Licence"
        };               
    }

    private MarkupString StepOneDescription => new MarkupString("<p>This means you are intending to use " +
    "APSIM in a commercial setting, such as for profit or business purposes.</p>");

    private MarkupString StepTwoDescription => new MarkupString("<p>This means you will only use installed versions of APSIM and not make any modifications to the source code.</p>");

    private MarkupString StepThreeDescription => new MarkupString("<p>This means you will be making changes to the APSIM source code, such as adding new features, adding new models, and fixing bugs or changing existing code.</p>");

    private MarkupString StepFourDescription => new MarkupString("<p>This means you are happy to submit any modifications you make back to the APSIM Initiative for potential inclusion in the main codebase.</p>");

    private List<Organisation> organisations = new List<Organisation>();

    private Organisation organisation { get; set; } = new();
    private User generalUseRegistration { get; set; } = new();      

    private bool isSpecialUseRegistrationVisible = false;
    private bool isGeneralUseRegistrationVisible = false;

    private bool showModal = false;
    private string modalMessage = string.Empty;
    private string modalTitle = string.Empty;

    public bool isCommercialUseDecisionCardVisible {get;set;} = true;
    public bool isUseInReleasedDecisionCardVisible {get;set;} = false;
    public bool isNoCodeChangesDecisionCardVisible {get;set;} = false;
    public bool areImprovementsSharedDecisionCardVisible {get;set;} = false;

    public List<string> GeneralDotPoints { get; set; } = new List<string>()
    {
        "For educational purposes, for personal learning, or for public good research",
        "Free of charge",
        "Required to submit modifications back to the APSIM Initiative for potential inclusion in the main codebase",
    };

    public List<string> SpecialDotPoints { get; set; } = new List<string>()
    {
        "For consulting, commercial research, or any activity that generates revenue.",
        "Requires a fee",
        "Licencee can keep modifications for private use (Type 2) or "+
        "submit back to the APSIM Initiative for potential inclusion in the main codebase (Type 1)"
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            organisations = (await webApiUtility.GetOrganisationsAsync()).
                Where(o => o.LicenceStatus == OrganisationLicenceStatus.Active).ToList() ?? 
                new List<Organisation>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred while fetching organisations from the API.");
            OpenModal("Error", "An error occurred while loading the registration form." +
                " Please try again later or submit an issue on our GitHub page: " +
                "https://github.com/APSIMInitiative/APSIM.RegistrationSystem");
        }
    }

    /// <summary>
    /// Toggles the visibility of the special use registration form and sets 
    /// the current step of the special use registration process.
    /// </summary>
    /// <returns></returns>
    private async Task ToggleSpecialSharingYes()
    {
        SpecialUseStep = 3;
        isSpecialUseRegistrationVisible = !isSpecialUseRegistrationVisible;
    }

    /// <summary>
    /// Toggles the visibility of the special use registration form.
    /// </summary>
    /// <returns></returns>
    private async Task ToggleSpecial() => isSpecialUseRegistrationVisible = !isSpecialUseRegistrationVisible;

    /// <summary>
    /// Toggles the visibility of the general use registration form.
    /// </summary>
    /// <returns></returns>
    private async Task ToggleGeneral() => isGeneralUseRegistrationVisible = !isGeneralUseRegistrationVisible;

    /// <summary>
    /// Toggles the visibility of the improvements shared decision card and sets the current step.
    /// </summary>
    /// <returns></returns>
    private async Task ToggleImprovementsShared()
    {
        areImprovementsSharedDecisionCardVisible = !areImprovementsSharedDecisionCardVisible;
        SpecialUseStep = 4;
    }

    /// <summary>
    /// Toggles the visibility of all decision cards and registration forms, and resets the current step to 0.
    /// </summary>
    /// <returns></returns>
    private async Task ToggleAll()
    {
        isCommercialUseDecisionCardVisible = true;
        areImprovementsSharedDecisionCardVisible = false;
        isSpecialUseRegistrationVisible = false;
        isGeneralUseRegistrationVisible = false;
        SpecialUseStep = 0;
    }


    /// <summary>
    /// Submits a registration application to the web API and shows a modal 
    /// with the response message. The response message will indicate if the 
    /// registration was successful or if there were any errors. 
    /// </summary>
    /// <param name="user"> The registration object containing the user's registration details.</param>
    /// <returns></returns>
    private async Task SubmitUserApplication(User user)
    {
        try
        {
            Logger.LogInformation($"Submitting application for {user.Email}");
            UserResponseModel response = await webApiUtility.CreateUserAsync(user);
            string title = "";
            string message = response.Message;
            if (response.IsSuccess)
            {
                Logger.LogInformation($"Registration successful for {user.Email}");
                message = "Registration successful!\n" +
                    $"A registration confirmation email has been sent to {user.Email}.\n" +
                    "Please check your email for a verification link to complete the registration process and download your product.";
                title = "Registration Submitted";           
            }
            else if (response.Message.Contains("A user with this email already exists."))   
            {
                Logger.LogWarning($"Registration attempt with existing email: {user.Email}");
                message = "A registration with this email already exists.\n" +
                    "If you have not received a confirmation email, please check your spam folder or contact support for assistance.\n" +
                    "Support Email: apsim@csiro.au";
                title = "Are you already registered?";
            }
            OpenModal(message, title);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"An error occurred while submitting registration for {user.Email}");
            OpenModal("Error Submitting Registration", "An error occurred while submitting your registration. Please try again later or submit an issue on our GitHub page: https://github.com/APSIMInitiative/APSIM.RegistrationSystem/issues");
        }
    }

    /// <summary>
    /// Submits an Organisation application to the web API and shows a modal
    /// </summary>
    /// <param name="organisation">The organisation registration object containing the organisation's details.</param>
    /// <returns></returns>
    private async Task SubmitOrganisationApplication(Organisation organisation)
    {
        try
        {
            Logger.LogInformation($"Submitting application for {organisation.ContactEmail} from {organisation.Name}");
            HttpResponseMessage response = await webApiUtility.AddOrganisationAsync(organisation);
            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation($"Special Use registration successful for {organisation.ContactEmail} with licence pathway {organisation.LicencePathway}");
                
                string message = $"A registration confirmation email has been sent to {organisation.ContactEmail}.\n" +
                    "A representative from the APSIM Initiative will be in touch to confirm your licence classification and next steps.\n";
                string title = "Registration Submitted For Review";
                OpenModal(message, title);
                this.organisation = new Organisation(); // Clear the form
            }
            else
            {
                Logger.LogError($"Failed to submit registration for {organisation.ContactEmail} from {organisation.Name}. Status Code: {response.StatusCode}");
                OpenModal("An error occurred while submitting your registration. Please try again later or submit an issue on our GitHub page: https://github.com/APSIMInitiative/APSIM.RegistrationSystem/issues", "Error Submitting Registration");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"An error occurred while submitting registration for {organisation.ContactEmail}");
            OpenModal("An error occurred while submitting your registration. Please try again later or submit an issue on our GitHub page: https://github.com/APSIMInitiative/APSIM.RegistrationSystem/issues", "Error Submitting Registration");
        }
    }

    /// <summary>Opens the modal with a given message and title. </summary>
    /// <param name="message">The message to display in the modal.</param>
    /// <param name="title">The title of the modal.</param>
    private void OpenModal(string message, string title)
    {
        showModal = true;
        modalMessage = message;
        modalTitle = title;
    }

}